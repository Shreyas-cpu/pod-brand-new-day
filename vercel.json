{
    "functions": {
        "api/**/*.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "routes": [
        {
            "src": "/",
            "dest": "/api/index.php"
        },
        {
            "src": "/try.php",
            "dest": "/api/try.php"
        },
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        }
    ]
}
